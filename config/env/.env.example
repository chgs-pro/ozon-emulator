# Values from the container environment (Docker Compose) take precedence over this file.
APP_ENV=dev
APP_DEBUG=0
# Public URL of the emulator: document links (label PDFs) are built from it.
APP_URL=http://localhost:8080
# PhpSoftBox Workspace MongoDB (profile "mongodb").
APP_MONGO_URI=mongodb://app:app@mongodb:27017/?authSource=admin
APP_MONGO_DB=ozon
